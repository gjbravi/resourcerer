{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "clusterName": { "type": "string" },
    "selection": { "type": "string", "enum": ["all", "label"] },
    "excludedNamespaces": { "type": "array", "items": { "type": "string" } },
    "prometheus": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "pattern": "^https?://" },
        "rateWindow": { "type": "string" },
        "minStep": { "type": "string" }
      }
    },
    "defaults": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "enum": ["auto", "karpenter", "static"] },
        "allocation": { "type": "string", "enum": ["cluster", "node"] },
        "rates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpuCoreHour": { "type": "number", "minimum": 0 },
            "memoryGiBHour": { "type": "number", "minimum": 0 }
          }
        },
        "karpenter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "refreshInterval": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h))+$" }
          }
        }
      }
    },
    "reliability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "builtin": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "throttling": { "$ref": "#/definitions/builtinSignal" },
            "memoryHeadroom": { "$ref": "#/definitions/builtinSignal" },
            "restarts": { "$ref": "#/definitions/builtinSignal" },
            "crashLoop": { "$ref": "#/definitions/builtinSignal" },
            "hpaAtMax": { "$ref": "#/definitions/builtinSignal" },
            "bestEffort": { "$ref": "#/definitions/builtinSignal" }
          }
        },
        "signals": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "unit", "query"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,40}[a-z0-9])?$" },
              "name": { "type": "string", "minLength": 1 },
              "description": { "type": "string" },
              "unit": { "type": "string", "enum": ["ratio", "count", "seconds", "bytes"] },
              "above": { "$ref": "#/definitions/levels" },
              "below": { "$ref": "#/definitions/levels" },
              "query": { "type": "string", "minLength": 1 },
              "runbook": { "type": "string" }
            },
            "oneOf": [{ "required": ["above"] }, { "required": ["below"] }]
          }
        }
      }
    },
    "applyPolicies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cluster": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "spec"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$" },
              "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
              "spec": { "type": "object", "description": "A ClusterApplyPolicy spec; the CRD validates its fields." }
            }
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": { "type": "string", "enum": ["anonymous", "oidc"] },
        "cookieSecure": {
          "oneOf": [{ "type": "string", "enum": ["auto", "true", "false"] }, { "type": "boolean" }]
        },
        "oidc": { "$ref": "#/definitions/oidcConfig" },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "keySecretRef": { "$ref": "#/definitions/secretRefOrUnset" },
            "keyPreviousSecretRef": { "$ref": "#/definitions/secretRefOrUnset" }
          }
        }
      },
      "oneOf": [
        { "properties": { "strategy": { "enum": ["anonymous"] } } },
        {
          "properties": {
            "strategy": { "enum": ["oidc"] },
            "oidc": {
              "required": ["issuer", "clientID", "clientSecretSecretRef"],
              "properties": {
                "issuer": { "pattern": "^https?://" },
                "clientID": { "minLength": 1 },
                "scopes": { "anyOf": [{ "maxItems": 0 }, { "contains": { "const": "openid" } }] },
                "clientSecretSecretRef": { "$ref": "#/definitions/secretRef" }
              }
            },
            "session": {
              "required": ["keySecretRef"],
              "properties": { "keySecretRef": { "$ref": "#/definitions/secretRef" } }
            }
          },
          "required": ["oidc", "session"]
        }
      ]
    },
    "readOnly": { "type": "boolean" },
    "controller": { "$ref": "#/definitions/component" },
    "applier": { "$ref": "#/definitions/component" },
    "server": { "$ref": "#/definitions/component" },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    }
  },
  "definitions": {
    "builtinSignal": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" }, "warn": { "type": "number", "minimum": 0 } }
    },
    "levels": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": { "warn": { "type": "number" }, "critical": { "type": "number" } }
    },
    "component": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 1 },
        "extraArgs": { "type": "array", "items": { "type": "string" } },
        "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
        "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "groups": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "secretRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "key"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "key": { "type": "string", "minLength": 1 } }
    },
    "secretRefOrUnset": {
      "type": "object",
      "oneOf": [{ "additionalProperties": { "enum": [""] } }, { "$ref": "#/definitions/secretRef" }]
    },
    "oidcConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issuer": { "type": "string", "pattern": "^$|^https?://" },
        "clientID": { "type": "string" },
        "redirectURL": { "type": "string", "pattern": "^$|^https?://" },
        "scopes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "usernameClaim": { "type": "string" },
        "groupsClaim": { "type": "string" },
        "allowedGroups": { "$ref": "#/definitions/groups" },
        "clientSecretSecretRef": { "$ref": "#/definitions/secretRefOrUnset" },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "editorGroups": { "$ref": "#/definitions/groups" },
            "anyAuthenticatedIsViewer": { "type": "boolean" }
          }
        },
        "sessionTTL": { "type": "string", "pattern": "^$|^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$" }
      }
    }
  }
}
