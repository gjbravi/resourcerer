{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "clusterName": { "type": "string" },
    "selection": { "type": "string", "enum": ["all", "label"] },
    "excludedNamespaces": { "type": "array", "items": { "type": "string" } },
    "prometheus": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "pattern": "^https?://" },
        "rateWindow": { "type": "string" },
        "minStep": { "type": "string" }
      }
    },
    "defaults": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "enum": ["auto", "karpenter", "static"] },
        "allocation": { "type": "string", "enum": ["cluster", "node"] },
        "rates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpuCoreHour": { "type": "number", "minimum": 0 },
            "memoryGiBHour": { "type": "number", "minimum": 0 }
          }
        },
        "karpenter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "refreshInterval": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h))+$" }
          }
        }
      }
    },
    "reliability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "builtin": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "throttling": { "$ref": "#/definitions/builtinSignal" },
            "memoryHeadroom": { "$ref": "#/definitions/builtinSignal" },
            "restarts": { "$ref": "#/definitions/builtinSignal" },
            "crashLoop": { "$ref": "#/definitions/builtinSignal" },
            "hpaAtMax": { "$ref": "#/definitions/builtinSignal" },
            "bestEffort": { "$ref": "#/definitions/builtinSignal" }
          }
        },
        "signals": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "unit", "query"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,40}[a-z0-9])?$" },
              "name": { "type": "string", "minLength": 1 },
              "description": { "type": "string" },
              "unit": { "type": "string", "enum": ["ratio", "count", "seconds", "bytes"] },
              "above": { "$ref": "#/definitions/levels" },
              "below": { "$ref": "#/definitions/levels" },
              "query": { "type": "string", "minLength": 1 },
              "runbook": { "type": "string" }
            },
            "oneOf": [{ "required": ["above"] }, { "required": ["below"] }]
          }
        }
      }
    },
    "applyPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "type": "string", "enum": ["Enforce", "Audit"] },
        "appliesTo": {
          "type": "array",
          "maxItems": 2,
          "items": { "type": "string", "enum": ["Auto", "Manual"] }
        },
        "windows": { "type": "array", "maxItems": 32, "items": { "$ref": "#/definitions/applyWindow" } },
        "freezes": { "type": "array", "maxItems": 64, "items": { "$ref": "#/definitions/applyFreeze" } },
        "cooldown": { "type": "string", "pattern": "^$|^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$" }
      }
    },
    "auth": { "type": "object", "properties": { "strategy": { "type": "string", "enum": ["anonymous"] } } },
    "readOnly": { "type": "boolean" },
    "controller": { "$ref": "#/definitions/component" },
    "applier": { "$ref": "#/definitions/component" },
    "server": { "$ref": "#/definitions/component" },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    }
  },
  "definitions": {
    "builtinSignal": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" }, "warn": { "type": "number", "minimum": 0 } }
    },
    "levels": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": { "warn": { "type": "number" }, "critical": { "type": "number" } }
    },
    "component": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 1 },
        "extraArgs": { "type": "array", "items": { "type": "string" } },
        "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
        "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "applyWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "days": {
          "type": "array",
          "maxItems": 7,
          "items": { "type": "string", "enum": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"] }
        },
        "from": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "to": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "timeZone": { "type": "string", "maxLength": 64 }
      }
    },
    "applyFreeze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "format": "date-time" },
        "to": { "type": "string", "format": "date-time" },
        "reason": { "type": "string" }
      }
    }
  }
}
