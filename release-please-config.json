{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "go",
  "bump-minor-pre-major": true,
  "include-component-in-tag": false,
  "pull-request-title-pattern": "chore: release ${version}",
  "versioning": "prerelease",
  "prerelease-type": "rc",
  "prerelease": true,
  "packages": {
    ".": {
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "yaml", "path": "charts/resourcerer/Chart.yaml", "jsonpath": "$.version" },
        { "type": "yaml", "path": "charts/resourcerer/Chart.yaml", "jsonpath": "$.appVersion" },
        { "type": "yaml", "path": "charts/resourcerer-crds/Chart.yaml", "jsonpath": "$.version" },
        { "type": "yaml", "path": "charts/resourcerer-crds/Chart.yaml", "jsonpath": "$.appVersion" }
      ]
    }
  }
}
